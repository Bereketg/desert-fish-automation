# =============================================================================
# NetBox application settings (non-secret).
# Secrets (SECRET_KEY, passwords, API token) come from the top-level .env
# file and are injected via the `environment:` block in docker-compose.yml.
# =============================================================================

# ── Database (must match postgres.env) ───────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=netbox
DB_USER=netbox
DB_CONN_MAX_AGE=300

# ── Redis — task queue ────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_SSL=false

# ── Redis — cache ─────────────────────────────────────────────────────────────
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DATABASE=1
REDIS_CACHE_SSL=false

# ── Application ───────────────────────────────────────────────────────────────
ALLOWED_HOSTS=*
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# ── First-run superuser ───────────────────────────────────────────────────────
# These only take effect when the database is first initialised.
# After that, manage users through the web UI or Django admin.
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=netadmin@desertfish.local
# SUPERUSER_PASSWORD and SUPERUSER_API_TOKEN come from .env via docker-compose

# ── Logging ───────────────────────────────────────────────────────────────────
LOGGING_ROOT_LEVEL=WARNING
