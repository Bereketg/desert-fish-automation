# =============================================================================
# Desert Fish — VM2 Environment Secrets
# Copy this file to .env and replace ALL placeholder values.
#
# IMPORTANT: .env is in .gitignore — NEVER commit it to Git.
#            Only .env.example (this file) is committed.
#
# Generate NETBOX_SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#
# Generate NETBOX_API_TOKEN with:
#   python3 -c "import secrets; print(secrets.token_hex(20))"
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=ChangeMe!DB#Str0ng

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=ChangeMe!Redis#Str0ng
REDIS_CACHE_PASSWORD=ChangeMe!RedisCache#Str0ng

# ── NetBox ────────────────────────────────────────────────────────────────────
# 50+ character random string — used to sign session cookies and CSRF tokens.
NETBOX_SECRET_KEY=REPLACE_WITH_50_CHAR_RANDOM_STRING

# Admin web UI credentials (used on first startup only)
NETBOX_SUPERUSER_PASSWORD=ChangeMe!Admin#Str0ng

# API token for Ansible and Oxidized to authenticate to NetBox REST API.
# Copy this value into:
#   - Automation/inventories/netbox_inventory.yml  (ansible_netbox_token)
#   - Automation/vm2-setup/oxidized/config          (token: field)
NETBOX_API_TOKEN=REPLACE_WITH_40_CHAR_HEX_STRING
